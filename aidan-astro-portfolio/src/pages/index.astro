<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Aidan Mansell — Guitarist, Tech, Playback</title>
  <meta name="description" content="Aidan Mansell. London based guitarist, guitar technician, playback tech and producer." />

  <link rel="preload" as="image" href="/images/hero.webp" />
  <link rel="preconnect" href="https://stream.mux.com" />
  <link rel="preconnect" href="https://player.mux.com" />

  <script type="module" src="https://cdn.jsdelivr.net/npm/@mux/mux-player@3/dist/mux-player.mjs"></script>

  <style>
    :root{
      --bg:#f4f1ea;
      --ink:#111111;
      --muted:#5f5a52;
      --line:#d8d2c6;
      --card:#fffaf0;
      --soft:#ebe5d8;
      --max:1180px;
    }

    *{box-sizing:border-box}

    html{scroll-behavior:smooth}

    body{
      margin:0;
      font-family:Arial, Helvetica, sans-serif;
      color:var(--ink);
      background:var(--bg);
      line-height:1.45;
    }

    a{color:inherit;text-decoration:none}
    img{width:100%;display:block}

    .wrap{
      max-width:var(--max);
      margin:0 auto;
      padding:0 22px;
    }

    header{
      position:sticky;
      top:0;
      z-index:20;
      backdrop-filter:blur(12px);
      background:rgba(244,241,234,.9);
      border-bottom:1px solid var(--line);
    }

    .nav{
      height:66px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
      text-transform:uppercase;
      font-size:12px;
      letter-spacing:.12em;
    }

    .brand{
      font-weight:800;
      letter-spacing:.04em;
    }

    .navlinks{
      display:flex;
      gap:18px;
      align-items:center;
      color:var(--muted);
    }

    .navlinks a:hover{color:var(--ink)}

    .hero{
      padding:72px 0 42px;
      border-bottom:1px solid var(--line);
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.08fr .92fr;
      gap:34px;
      align-items:end;
    }

    .eyebrow{
      text-transform:uppercase;
      letter-spacing:.18em;
      font-size:12px;
      color:var(--muted);
      margin-bottom:18px;
    }

    h1{
      margin:0;
      font-size:clamp(58px,10vw,132px);
      letter-spacing:-.075em;
      line-height:.82;
      max-width:840px;
    }

    .intro{
      margin:26px 0 0;
      max-width:620px;
      font-size:clamp(18px,2vw,25px);
      letter-spacing:-.025em;
    }

    .hero-card{
      border:1px solid var(--ink);
      background:var(--card);
      padding:18px;
      min-height:350px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .hero-card img{
      height:420px;
      object-fit:cover;
      object-position:center 62%;
      filter:contrast(1.08) saturate(.92);
    }

    .meta-row{
      display:flex;
      justify-content:space-between;
      gap:12px;
      border-top:1px solid var(--line);
      padding-top:14px;
      margin-top:16px;
      color:var(--muted);
      font-size:13px;
      text-transform:uppercase;
      letter-spacing:.08em;
    }

    .button{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      border:1px solid var(--ink);
      padding:12px 16px;
      text-transform:uppercase;
      font-size:12px;
      letter-spacing:.12em;
      background:var(--ink);
      color:var(--bg);
    }

    .button.light{
      background:transparent;
      color:var(--ink);
    }

    .button:hover{opacity:.82}

    .stats{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:1px;
      background:var(--line);
      border-bottom:1px solid var(--line);
    }

    .stat{
      background:var(--bg);
      padding:22px;
    }

    .stat b{
      display:block;
      font-size:28px;
      letter-spacing:-.05em;
    }

    .stat span{
      display:block;
      color:var(--muted);
      font-size:12px;
      text-transform:uppercase;
      letter-spacing:.1em;
      margin-top:6px;
    }

    section{
      padding:70px 0;
      border-bottom:1px solid var(--line);
    }

    .section-head{
      display:flex;
      align-items:end;
      justify-content:space-between;
      gap:24px;
      margin-bottom:26px;
    }

    h2{
      font-size:clamp(34px,5vw,64px);
      line-height:.9;
      letter-spacing:-.06em;
      margin:0;
      text-transform:uppercase;
    }

    .section-note{
      max-width:430px;
      color:var(--muted);
      font-size:15px;
    }

    .about-strip{
      margin:0 0 22px;
      border:1px solid var(--ink);
      background:var(--card);
      display:grid;
      grid-template-columns:.85fr 1.15fr;
      gap:1px;
      background-color:var(--ink);
    }

    .about-strip > div{
      background:var(--card);
      padding:18px;
    }

    .about-strip h3{
      margin:0;
      font-size:clamp(26px,3.4vw,44px);
      line-height:.92;
      letter-spacing:-.055em;
      text-transform:uppercase;
    }

    .about-strip p{
      margin:0;
      color:var(--muted);
      font-size:16px;
      max-width:760px;
    }

    .about-chips{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:18px;
    }

    .tag{
      display:inline-flex;
      border:1px solid rgba(17,17,17,.34);
      padding:7px 10px;
      border-radius:999px;
      font-size:12px;
      color:#4b463f;
      background:rgba(255,255,255,.58);
      text-transform:uppercase;
      letter-spacing:.08em;
    }

    .work-list{
      display:grid;
      gap:12px;
    }

    .work-item{
      border:1px solid var(--ink);
      background:var(--card);
      padding:0;
      display:grid;
      grid-template-columns:280px 1fr 120px;
      align-items:stretch;
      overflow:hidden;
    }

    .work-main{
      padding:18px;
      border-right:1px solid var(--line);
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      gap:18px;
    }

    .work-item h3{
      margin:0;
      font-size:28px;
      letter-spacing:-.055em;
      line-height:.9;
      text-transform:uppercase;
    }

    .work-role{
      margin-top:8px;
      color:var(--muted);
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.13em;
    }

    .work-details{padding:18px}

    .work-item p{
      margin:0;
      color:var(--muted);
      font-size:15px;
      line-height:1.45;
      max-width:720px;
    }

    .work-year{
      padding:18px;
      border-left:1px solid var(--line);
      display:flex;
      align-items:flex-start;
      justify-content:flex-end;
      color:var(--muted);
      font-size:12px;
      text-transform:uppercase;
      letter-spacing:.08em;
      text-align:right;
      white-space:nowrap;
    }

    .credit-tags{
      display:flex;
      flex-wrap:wrap;
      gap:6px;
      margin-top:14px;
    }

    .credit-tags span{
      border:1px solid rgba(17,17,17,.28);
      border-radius:999px;
      padding:5px 8px;
      font-size:11px;
      color:#4d4942;
      text-transform:uppercase;
      letter-spacing:.06em;
      background:rgba(255,255,255,.48);
    }

    .credit-label{
      font-size:11px;
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.14em;
    }

    .watch-shell{
      border:1px solid var(--ink);
      background:var(--card);
      overflow:hidden;
      padding:28px 20px 20px;
    }

    .reel-carousel{
      display:grid;
      grid-template-columns:repeat(3, minmax(230px, 320px));
      gap:18px;
      align-items:center;
      justify-content:center;
      min-height:560px;
    }

    .reel-panel{
      aspect-ratio:9/16;
      width:100%;
      border:1px solid var(--ink);
      background:#111;
      overflow:hidden;
      position:relative;
    }

    .reel-side{
      cursor:pointer;
      opacity:.55;
      transform:scale(.92);
      transition:opacity .35s ease, transform .35s ease, filter .35s ease;
      filter:grayscale(.12) contrast(.92);
      padding:0;
    }

    .reel-side:hover{
      opacity:.9;
      transform:scale(.96);
      filter:grayscale(0) contrast(1);
    }

    .reel-main{
      transform:translateY(0);
      transition:transform .35s ease, opacity .35s ease;
      box-shadow:0 18px 50px rgba(17,17,17,.12);
    }

    .reel-main.is-changing{
      opacity:.35;
      transform:translateY(8px) scale(.985);
    }

    .video-player,
    .preview-player{
      width:100%;
      height:100%;
      display:block;
      background:#111;
      --media-object-fit:cover;
      --media-object-position:center;
      --media-primary-color:#f4f1ea;
      --media-secondary-color:#111111;
      --media-control-background:rgba(0,0,0,.22);
      --media-control-hover-background:rgba(0,0,0,.36);
    }

    .preview-player{
      pointer-events:none;
    }

    .reel-side::after{
      content:attr(data-label);
      position:absolute;
      left:12px;
      bottom:12px;
      border:1px solid rgba(244,241,234,.7);
      color:#f4f1ea;
      background:rgba(0,0,0,.32);
      padding:8px 10px;
      text-transform:uppercase;
      letter-spacing:.12em;
      font-size:11px;
      backdrop-filter:blur(8px);
      z-index:4;
    }

    .reel-caption{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:20px;
      border-top:1px solid var(--line);
      margin-top:20px;
      padding-top:18px;
      color:var(--muted);
      text-transform:uppercase;
      letter-spacing:.12em;
      font-size:12px;
    }

    .carousel-controls{
      display:flex;
      align-items:center;
      gap:10px;
    }

    .carousel-btn{
      appearance:none;
      border:1px solid var(--ink);
      background:transparent;
      color:var(--ink);
      width:44px;
      height:40px;
      display:grid;
      place-items:center;
      cursor:pointer;
      font-size:18px;
      line-height:1;
    }

    .carousel-btn:hover{
      background:var(--ink);
      color:var(--bg);
    }

    .carousel-count{
      color:var(--muted);
      white-space:nowrap;
      min-width:70px;
      text-align:center;
    }

    .dots{
      display:flex;
      flex-wrap:wrap;
      gap:7px;
      justify-content:center;
    }

    .dot{
      width:7px;
      height:7px;
      border-radius:999px;
      border:1px solid var(--ink);
      background:transparent;
      padding:0;
      cursor:pointer;
      opacity:.45;
    }

    .dot.is-active{
      background:var(--ink);
      opacity:1;
    }

    .details-compact{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:10px;
    }

    .detail-card{
      border:1px solid var(--ink);
      background:var(--card);
      padding:16px;
      min-height:150px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .detail-card .label{
      color:var(--muted);
      font-size:11px;
      letter-spacing:.14em;
      text-transform:uppercase;
      margin-bottom:12px;
    }

    .detail-card h3{
      margin:0 0 8px;
      font-size:22px;
      line-height:.95;
      letter-spacing:-.045em;
      text-transform:uppercase;
    }

    .detail-card p{
      margin:0;
      color:var(--muted);
      font-size:14px;
      line-height:1.35;
    }

    .micro{
      margin-top:14px;
      display:flex;
      flex-wrap:wrap;
      gap:6px;
    }

    .micro span{
      border:1px solid rgba(17,17,17,.28);
      padding:5px 8px;
      border-radius:999px;
      font-size:11px;
      color:#4d4942;
      background:rgba(255,255,255,.48);
      white-space:nowrap;
    }

    .photos-wall{
      column-count:3;
      column-gap:14px;
    }

    .photo-piece{
      break-inside:avoid;
      margin:0 0 14px;
      border:1px solid var(--ink);
      background:var(--soft);
      overflow:hidden;
    }

    .photo-piece img{
      width:100%;
      height:auto;
      display:block;
      object-fit:contain;
      filter:contrast(1.04) saturate(.96);
    }

    .contact{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:20px;
      align-items:end;
    }

    .contact h2{
      font-size:clamp(48px,8vw,104px);
    }

    .contact-links{
      display:grid;
      gap:10px;
    }

    .contact-links a{
      border:1px solid var(--ink);
      padding:16px;
      background:var(--card);
      display:flex;
      justify-content:space-between;
      gap:18px;
      text-transform:uppercase;
      font-size:13px;
      letter-spacing:.08em;
    }

    .contact-links a:hover{
      background:var(--ink);
      color:var(--bg);
    }

    @media(max-width:1000px){
      .details-compact{grid-template-columns:repeat(2,1fr)}

      .work-item{grid-template-columns:1fr}

      .work-main{
        border-right:0;
        border-bottom:1px solid var(--line);
      }

      .work-year{
        border-left:0;
        border-top:1px solid var(--line);
        justify-content:flex-start;
        text-align:left;
      }

      .photos-wall{column-count:2}

      .reel-carousel{
        grid-template-columns:repeat(3, minmax(190px, 1fr));
        gap:12px;
      }
    }

    @media(max-width:850px){
      .hero-grid,
      .contact{
        grid-template-columns:1fr;
      }

      .hero-card img{height:360px}

      .stats{grid-template-columns:repeat(2,1fr)}
      .about-strip{grid-template-columns:1fr}
      .navlinks{display:none}

      section{padding:52px 0}

      .reel-carousel{
        grid-template-columns:1fr;
        max-width:390px;
        min-height:auto;
        margin:0 auto;
      }

      .reel-side{display:none}

      .reel-caption{
        flex-direction:column;
        align-items:flex-start;
      }

      .dots{justify-content:flex-start}
    }

    @media(max-width:650px){
      .details-compact{grid-template-columns:1fr}
      .contact-links a{flex-direction:column}
      .photos-wall{column-count:1}
    }
  </style>
</head>

<body>
  <header>
    <div class="wrap nav">
      <a class="brand" href="#top">Aidan Mansell</a>

      <nav class="navlinks">
        <a href="#work">Work</a>
        <a href="#watch">Watch</a>
        <a href="#details">Details</a>
        <a href="#photos">Photos</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <div class="eyebrow">London based guitarist</div>

          <h1>Live guitar, clean rigs, reliable shows.</h1>

          <p class="intro">
            Guitarist, guitar technician, playback tech and producer working across live shows,
            sessions, touring, rehearsal rooms and studio projects.
          </p>

          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:28px">
            <a class="button" href="#work">View work</a>
            <a class="button light" href="#watch">Watch</a>
          </div>
        </div>

        <aside class="hero-card">
          <img src="/images/hero.webp" alt="Aidan Mansell playing guitar live on stage" fetchpriority="high" width="900" height="1200" />

          <div class="meta-row">
            <span>Guitar / Tech / Playback</span>
            <span>London, UK</span>
          </div>
        </aside>
      </div>
    </section>

    <div class="wrap stats">
      <div class="stat">
        <b>10+</b>
        <span>years live playing</span>
      </div>

      <div class="stat">
        <b>Touring</b>
        <span>guitar and tech work</span>
      </div>

      <div class="stat">
        <b>Playback</b>
        <span>clicks, cues and stems</span>
      </div>

      <div class="stat">
        <b>UK</b>
        <span>full driving licence</span>
      </div>
    </div>

    <section id="work">
      <div class="wrap">
        <div class="section-head">
          <h2>Work</h2>
          <p class="section-note">Selected touring, festival, session, tech and music industry work.</p>
        </div>

        <div class="about-strip">
          <div>
            <div class="eyebrow">About</div>
            <h3>Sydney raised, UK based.</h3>
          </div>

          <div>
            <p>
              I moved from Sydney to the UK in 2022. Since then I have worked across live shows,
              tours, studio sessions, guitar tech, playback, production and music marketing.
            </p>

            <div class="about-chips">
              <span class="tag">Sydney to London</span>
              <span class="tag">Session guitarist</span>
              <span class="tag">Guitar tech</span>
              <span class="tag">Playback tech</span>
              <span class="tag">Production</span>
            </div>
          </div>
        </div>

        <div class="work-list">
          <div class="work-item">
            <div class="work-main">
              <div>
                <h3>South Arcade</h3>
                <div class="work-role">Guitar technician</div>
              </div>
              <div class="credit-label">Tour / Festival / Tech</div>
            </div>
            <div class="work-details">
              <p>Arc Angel UK Tour. Reading and Leeds 2024. I Was Here First UK Tour. As Everything Unfolds headline UK tour.</p>
              <div class="credit-tags">
                <span>guitar tech</span>
                <span>UK tour</span>
                <span>Reading and Leeds</span>
                <span>headline tour</span>
              </div>
            </div>
            <div class="work-year">2023 to 2025</div>
          </div>

          <div class="work-item">
            <div class="work-main">
              <div>
                <h3>Jaxn</h3>
                <div class="work-role">Session guitarist</div>
              </div>
              <div class="credit-label">Live / Session</div>
            </div>
            <div class="work-details">
              <p>South Arcade Arc Angel Tour. BBC Introducing Manchester.</p>
              <div class="credit-tags">
                <span>touring</span>
                <span>BBC Introducing</span>
                <span>live guitar</span>
              </div>
            </div>
            <div class="work-year">2024 to 2025</div>
          </div>

          <div class="work-item">
            <div class="work-main">
              <div>
                <h3>Lizzy Farrell</h3>
                <div class="work-role">Session guitarist</div>
              </div>
              <div class="credit-label">Tour / Festival</div>
            </div>
            <div class="work-details">
              <p>As December Falls Join The Club EU and UK Tour. Misery Loves Company Festival. Burn It Down Festival. No Play Festival.</p>
              <div class="credit-tags">
                <span>EU and UK tour</span>
                <span>festivals</span>
                <span>session guitar</span>
              </div>
            </div>
            <div class="work-year">2024</div>
          </div>

          <div class="work-item">
            <div class="work-main">
              <div>
                <h3>Entertainment Nation</h3>
                <div class="work-role">Function band guitarist</div>
              </div>
              <div class="credit-label">Function / Dep work</div>
            </div>
            <div class="work-details">
              <p>Function band work across live events, weddings and private performances.</p>
              <div class="credit-tags">
                <span>function band</span>
                <span>live sets</span>
                <span>dep work</span>
                <span>events</span>
              </div>
            </div>
            <div class="work-year">2025 to Present</div>
          </div>

          <div class="work-item">
            <div class="work-main">
              <div>
                <h3>JDW Media</h3>
                <div class="work-role">Marketing team</div>
              </div>
              <div class="credit-label">Music marketing</div>
            </div>
            <div class="work-details">
              <p>Music campaign work with clients including Atlantic Records UK.</p>
              <div class="credit-tags">
                <span>music marketing</span>
                <span>campaigns</span>
                <span>Atlantic Records UK</span>
              </div>
            </div>
            <div class="work-year">2026 to Present</div>
          </div>

          <div class="work-item">
            <div class="work-main">
              <div>
                <h3>Zack Fowler</h3>
                <div class="work-role">Session guitarist</div>
              </div>
              <div class="credit-label">Touring</div>
            </div>
            <div class="work-details">
              <p>Area 11 All The Lights In The Sky Tour. WSTR 2024 Tour.</p>
              <div class="credit-tags">
                <span>touring</span>
                <span>live guitar</span>
                <span>session guitar</span>
              </div>
            </div>
            <div class="work-year">2023 to 2024</div>
          </div>

          <div class="work-item">
            <div class="work-main">
              <div>
                <h3>Mayah</h3>
                <div class="work-role">Session guitarist</div>
              </div>
              <div class="credit-label">Festival</div>
            </div>
            <div class="work-details">
              <p>The Great Prescape Festival, Brighton.</p>
              <div class="credit-tags">
                <span>festival</span>
                <span>Brighton</span>
                <span>live guitar</span>
              </div>
            </div>
            <div class="work-year">2026</div>
          </div>

          <div class="work-item">
            <div class="work-main">
              <div>
                <h3>Start Small Studio</h3>
                <div class="work-role">Producer / session guitarist</div>
              </div>
              <div class="credit-label">Studio</div>
            </div>
            <div class="work-details">
              <p>Studio work, guitar tracking, production support and session guitar.</p>
              <div class="credit-tags">
                <span>studio</span>
                <span>production</span>
                <span>session guitar</span>
              </div>
            </div>
            <div class="work-year">2025 to Present</div>
          </div>

          <div class="work-item">
            <div class="work-main">
              <div>
                <h3>James Walker</h3>
