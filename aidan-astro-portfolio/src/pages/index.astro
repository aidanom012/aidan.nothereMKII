  <script is:inline>
    const videoItems = [
      { playbackId: "3oM00bx8DJ01WVeSrZ1rBHnCGt7x01EDinT2yoFj6Fmido", start: 2 },
      { playbackId: "WZFBswhStjPED87pePirmR00fPIOtHW9vElxUNZDy00q00", start: 2 },
      { playbackId: "o3SUEQnAKLHahw1WyyKJlnk7fWtKyG2ahKty5Jz86XE", start: 2 },
      { playbackId: "MSv8ow9h9e9dtoT02RJWi01sPH98DqYKdN1xdXXoCoWNI", start: 2 },
      { playbackId: "tufJEABNMT01wLGkgkGGk5j6DgVCyVOONDVeAUlrx4Is", start: 2 },
      { playbackId: "fXogupp27a402VtojlPAP8KmoHtOW3eSKKJkwB6liXIs", start: 2 }
    ];

    const mainReel = document.getElementById("mainReel");
    const prevPreview = document.getElementById("prevPreview");
    const nextPreview = document.getElementById("nextPreview");
    const dots = document.getElementById("videoDots");
    const count = document.getElementById("videoCount");
    const prev = document.getElementById("prevVideo");
    const next = document.getElementById("nextVideo");

    let activeIndex = 3;

    function pad(num){
      return String(num).padStart(2, "0");
    }

    function getPrevIndex(){
      return activeIndex === 0 ? videoItems.length - 1 : activeIndex - 1;
    }

    function getNextIndex(){
      return activeIndex === videoItems.length - 1 ? 0 : activeIndex + 1;
    }

    function playerMarkup(item, className, controls){
      return `
        <mux-player
          class="${className}"
          playback-id="${item.playbackId}"
          stream-type="on-demand"
          preload="metadata"
          ${controls ? "controls" : ""}
          ${controls ? "" : "muted autoplay loop playsinline"}
        ></mux-player>
      `;
    }

    function renderDots(){
      dots.innerHTML = "";

      videoItems.forEach((item, index) => {
        const dot = document.createElement("button");
        dot.className = "dot";
        dot.type = "button";
        dot.setAttribute("aria-label", "Go to video " + (index + 1));
        dot.classList.toggle("is-active", index === activeIndex);
        dot.addEventListener("click", () => goToVideo(index));
        dots.appendChild(dot);
      });
    }

    function startPreviewPlayers(){
      const previews = document.querySelectorAll(".preview-player");

      previews.forEach((player) => {
        const start = Number(player.dataset.start || 2);

        const startAndPlay = () => {
          try{
            player.currentTime = start;
            const playPromise = player.play();
            if(playPromise && typeof playPromise.catch === "function"){
              playPromise.catch(() => {});
            }
          }catch(error){}
        };

        player.addEventListener("loadedmetadata", startAndPlay, { once:true });

        setTimeout(startAndPlay, 600);
      });
    }

    function renderPreview(button, index, label){
      const item = videoItems[index];

      button.dataset.label = `${label} ${pad(index + 1)}`;
      button.innerHTML = playerMarkup(item, "preview-player", false);

      const player = button.querySelector("mux-player");
      player.dataset.start = item.start || 2;
    }

    function renderMain(){
      const item = videoItems[activeIndex];

      mainReel.classList.add("is-changing");

      setTimeout(() => {
        mainReel.innerHTML = playerMarkup(item, "video-player", true);

        count.textContent = `${pad(activeIndex + 1)} / ${pad(videoItems.length)}`;

        renderPreview(prevPreview, getPrevIndex(), "Previous");
        renderPreview(nextPreview, getNextIndex(), "Next");
        renderDots();
        startPreviewPlayers();

        requestAnimationFrame(() => {
          mainReel.classList.remove("is-changing");
        });
      }, 130);
    }

    function goToVideo(index){
      if(index < 0) index = videoItems.length - 1;
      if(index >= videoItems.length) index = 0;

      activeIndex = index;
      renderMain();
    }

    prev.addEventListener("click", () => goToVideo(activeIndex - 1));
    next.addEventListener("click", () => goToVideo(activeIndex + 1));
    prevPreview.addEventListener("click", () => goToVideo(getPrevIndex()));
    nextPreview.addEventListener("click", () => goToVideo(getNextIndex()));

    document.addEventListener("keydown", (event) => {
      if(event.key === "ArrowLeft") goToVideo(activeIndex - 1);
      if(event.key === "ArrowRight") goToVideo(activeIndex + 1);
    });

    renderMain();
  </script>
